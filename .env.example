# .env.example
# Copy this file to .env and fill in values ONLY if you want to enable optional
# integrations. The platform runs fully offline/locally with mock providers
# if you leave everything blank - no API keys are required.

# --- Threat Intelligence (optional) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# --- AI-Assisted Incident Analysis (optional) ---
GROQ_API_KEY=

# --- Notifications (optional) ---
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=

# --- Experimental Wazuh connector (optional; not live-validated) ---
# Complements (does not replace) the file-based Wazuh JSON export adapter.
# Leave blank to keep using offline demo data / file exports only.
WAZUH_API_URL=
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=
# Set to "false" only in an isolated lab with a self-signed cert you trust.
WAZUH_VERIFY_SSL=true
WAZUH_REQUEST_TIMEOUT=10

# --- Splunk Enterprise REST API (optional, live local-lab integration) ---
SPLUNK_URL=https://localhost:8089
SPLUNK_TOKEN=
SPLUNK_INDEX=main
SPLUNK_SOURCETYPE=WinEventLog:Security
# false is acceptable only for a trusted localhost lab using Splunk's self-signed certificate.
SPLUNK_VERIFY_SSL=false
SPLUNK_REQUEST_TIMEOUT=30
SPLUNK_MAX_EVENTS=500

# --- Real response actions (dangerous - leave disabled unless in an isolated lab) ---
# Setting this to "true" overrides response_policy.yaml's simulation_mode to false.
ITRAP_DISABLE_SIMULATION=false
